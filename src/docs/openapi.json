{
  "openapi": "3.0.3",
  "info": {
    "title": "Repairex API",
    "version": "0.2.0",
    "description": "Smart electronics repair marketplace backend (Authentication, Contact & Public API)."
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local development" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "environment": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Submit a public contact message",
        "tags": ["Public"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fullName", "email", "topic", "message"],
                "properties": {
                  "fullName": { "type": "string", "example": "Alex Doe" },
                  "email": { "type": "string", "example": "alex@example.com" },
                  "phone": { "type": "string", "example": "+1 555-0100" },
                  "topic": {
                    "type": "string",
                    "enum": ["repair-request", "vendor-inquiry", "support", "general"],
                    "example": "repair-request"
                  },
                  "message": { "type": "string", "example": "Need my iPhone screen replaced." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message received"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Register a new user and dispatch email OTP",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fullName", "email", "password", "confirmPassword", "role"],
                "properties": {
                  "fullName": { "type": "string", "example": "Andrew Thomas" },
                  "email": { "type": "string", "example": "andrew@example.com" },
                  "password": { "type": "string", "example": "Password123!" },
                  "confirmPassword": { "type": "string", "example": "Password123!" },
                  "role": { "type": "string", "enum": ["customer", "vendor"], "example": "customer" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Verification OTP sent" },
          "400": { "description": "Invalid input" },
          "409": { "description": "Email already in use" }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify email OTP and establish HTTP-only session",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "otp"],
                "properties": {
                  "email": { "type": "string", "example": "andrew@example.com" },
                  "otp": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Email verified and session established" },
          "400": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in with email and password",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "andrew@example.com" },
                  "password": { "type": "string", "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logged in successfully" },
          "401": { "description": "Invalid credentials or unverified email" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user from session cookie",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Clear session cookie",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "summary": "Authenticate using Google Identity Services ID token (credential)",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["credential"],
                "properties": {
                  "credential": {
                    "type": "string",
                    "description": "Cryptographically signed JWT ID token from Google Identity Services"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Google authentication successful, session cookie set" },
          "400": { "description": "Invalid payload or unverified Google email" },
          "401": { "description": "Invalid, expired, or audience-mismatched token" }
        }
      },
      "get": {
        "summary": "Initiate Google OAuth redirect flow (fallback)",
        "tags": ["Auth"],
        "responses": {
          "302": { "description": "Redirect to Google authorization endpoint" }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "summary": "Google OAuth authorization callback",
        "tags": ["Auth"],
        "responses": {
          "302": { "description": "Session established and redirected to dashboard" }
        }
      }
    },
    "/api/repairs": {
      "post": {
        "summary": "Create a new repair request (Customer only)",
        "tags": ["Repairs"],
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["deviceType", "brand", "modelName", "issueCategory", "description"],
                "properties": {
                  "deviceType": { "type": "string", "enum": ["phone", "laptop", "tablet", "audio", "smartwatch", "other"], "example": "phone" },
                  "brand": { "type": "string", "example": "Apple" },
                  "modelName": { "type": "string", "example": "iPhone 14 Pro" },
                  "issueCategory": { "type": "string", "enum": ["screen", "battery", "charging", "water_damage", "audio", "software", "camera", "hardware", "other"], "example": "screen" },
                  "description": { "type": "string", "example": "OLED screen cracked after a drop, touch unresponsive." },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": { "type": "string" },
                        "publicId": { "type": "string" }
                      }
                    }
                  },
                  "urgency": { "type": "string", "enum": ["low", "medium", "high", "immediate"], "example": "high" },
                  "estimatedBudgetMin": { "type": "number", "example": 2000 },
                  "estimatedBudgetMax": { "type": "number", "example": 5000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Repair request created successfully" },
          "400": { "description": "Validation error" },
          "401": { "description": "Not authenticated" },
          "403": { "description": "Restricted to customers" }
        }
      },
      "get": {
        "summary": "List all repair requests submitted by the logged-in customer",
        "tags": ["Repairs"],
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Array of repair requests" },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/api/repairs/{id}": {
      "get": {
        "summary": "Get details of a specific repair request by ID",
        "tags": ["Repairs"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Repair request detail object" },
          "401": { "description": "Not authenticated" },
          "404": { "description": "Repair request not found" }
        }
      }
    },
    "/api/repairs/upload-image": {
      "post": {
        "summary": "Upload a repair image attachment to Cloudinary",
        "tags": ["Repairs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["imageData"],
                "properties": {
                  "imageData": { "type": "string", "description": "Base64 data URI (data:image/...)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Image uploaded successfully, returns URL and public ID" },
          "400": { "description": "Invalid image payload" },
          "401": { "description": "Not authenticated" }
        }
      }
    },
    "/api/marketplace/repairs": {
      "get": {
        "summary": "Browse open customer repair requests available for estimation (Vendor only)",
        "tags": ["Marketplace"],
        "parameters": [
          { "name": "deviceType", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "urgency", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of open repair requests" },
          "401": { "description": "Not authenticated" },
          "403": { "description": "Forbidden (Vendor only)" }
        }
      }
    },
    "/api/repairs/{id}/estimates": {
      "get": {
        "summary": "Get all estimates submitted for a repair request",
        "tags": ["Estimates"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of estimates" },
          "401": { "description": "Not authenticated" },
          "403": { "description": "Forbidden" }
        }
      },
      "post": {
        "summary": "Submit a repair estimate (Vendor only)",
        "tags": ["Estimates"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["minCost", "maxCost", "turnaroundTime", "notes"],
                "properties": {
                  "minCost": { "type": "number", "example": 80 },
                  "maxCost": { "type": "number", "example": 120 },
                  "turnaroundTime": { "type": "string", "example": "24 Hours" },
                  "warrantyMonths": { "type": "number", "example": 6 },
                  "notes": { "type": "string", "example": "OEM replacement screen with 6 months warranty." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Estimate submitted successfully" },
          "400": { "description": "Invalid input or request closed" },
          "409": { "description": "Vendor has already submitted an estimate" }
        }
      }
    },
    "/api/repairs/{id}/select-estimate": {
      "post": {
        "summary": "Accept an estimate and assign vendor to ticket (Customer only)",
        "tags": ["Estimates"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["estimateId"],
                "properties": {
                  "estimateId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Estimate accepted, vendor assigned, and status advanced to vendor_selected" },
          "400": { "description": "Vendor already assigned or request closed" },
          "403": { "description": "Forbidden (Only ticket owner customer can select)" },
          "404": { "description": "Estimate not found" }
        }
      }
    },
    "/api/repairs/{id}/diagnosis": {
      "post": {
        "summary": "Submit physical diagnosis findings and itemized quotation (Assigned Vendor only)",
        "tags": ["Quotations"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["diagnosticFindings", "lineItems", "estimatedCompletion"],
                "properties": {
                  "diagnosticFindings": { "type": "string", "example": "Diagnostic findings text" },
                  "lineItems": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["description", "category", "cost"],
                      "properties": {
                        "description": { "type": "string" },
                        "category": { "type": "string", "enum": ["parts", "labor", "consumable", "other"] },
                        "cost": { "type": "number" }
                      }
                    }
                  },
                  "estimatedCompletion": { "type": "string", "example": "2 Days" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Diagnostic quotation submitted successfully" },
          "403": { "description": "Forbidden (Only assigned vendor can submit)" }
        }
      }
    },
    "/api/repairs/{id}/quotation": {
      "get": {
        "summary": "Retrieve itemized quotation for repair ticket",
        "tags": ["Quotations"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Itemized quotation details" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Repair not found" }
        }
      }
    },
    "/api/repairs/{id}/quotation/decision": {
      "post": {
        "summary": "Customer decision on quotation (approve/reject)",
        "tags": ["Quotations"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["decision"],
                "properties": {
                  "decision": { "type": "string", "enum": ["approved", "rejected"] },
                  "feedback": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Quotation decision recorded" },
          "400": { "description": "Already decided or invalid decision" },
          "403": { "description": "Forbidden (Only ticket customer can decide)" }
        }
      }
    }
  }
}
