{
  "openapi": "3.0.3",
  "info": {
    "title": "Repairex API",
    "version": "0.1.0",
    "description": "Smart electronics repair marketplace backend (Phase 0 foundation)."
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local development" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "environment": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
