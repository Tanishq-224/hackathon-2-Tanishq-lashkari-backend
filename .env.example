# Repairex backend — copy to `.env` for local development.

NODE_ENV=development
PORT=5000

# Frontend origin for CORS (Vite default)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (optional until Phase 2+ features need DB)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/repairex

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Future phases — placeholders only (do not commit real values)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# EMAIL_PROVIDER_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# SESSION_SECRET=
