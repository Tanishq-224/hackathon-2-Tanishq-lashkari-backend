NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Session Secret (min 16 chars)
SESSION_SECRET=repairex-super-secure-session-key-dev-32-chars

# MongoDB Connection (Local or Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/repairex

# Email Configuration
# Option A: Standard SMTP (Gmail, Brevo, SendGrid)
# NOTE: Cloud hosts like Render Free Tier block outbound ports 25, 465, and 587.
# For Port 465, secure=true is automatically used. For Port 587 or 2525, secure=false is used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Option B: Resend HTTP API (Recommended for Render & Serverless - uses HTTPS Port 443, never blocked)
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
